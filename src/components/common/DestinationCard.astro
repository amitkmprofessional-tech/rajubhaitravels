---
export interface Props{title:string;image:string;link:string;}
const {title,image,link}=Astro.props;
---
<a class='card' href={link}><img src={image} alt={title}/><h3>{title}</h3></a><style>.card{display:block;text-decoration:none;color:#111;background:#fff;border-radius:14px;overflow:hidden;box-shadow:0 8px 18px rgba(0,0,0,.08)}img{width:100%;height:180px;object-fit:cover}h3{padding:16px}</style>