---
export interface Props {
  brand?: string;
}
const { brand = "rajubhaitravels" } = Astro.props;
---

<nav class="nav shell" aria-label="Primary navigation">
  <a href="/" class="brand" translate="no">
  <img
    src="/logo.png"
    alt="Rajubhai Travels Logo"
    class="brand-logo"
  />

  <span>
    {brand}<span class="brand-domain">.com</span>
  </span>
</a>
  <div class="nav-links">
    <a href="#fleet">Our fleet</a>
    <a href="#customers">Our Happy Customers</a>
    <a href="#business">Business</a>
    <a href="#help">Help</a>
  </div>
  <div class="nav-actions">
    <a class="ghost" href="#help">Log in</a>
    <a class="nav-cta" href="#booking-form">Create account</a>
  </div>
</nav>
