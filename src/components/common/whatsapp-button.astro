---
// Set the business WhatsApp number (with country code, digits only) via
// env var so it's not hardcoded — falls back to a placeholder that will
// visibly fail so it's obvious it needs configuring.
const phone = import.meta.env.PUBLIC_WHATSAPP_NUMBER || "";
const message = encodeURIComponent(
  "Hi Raju Bhai Travels, I would like to book a ride."
);
const href = phone
  ? `https://wa.me/${phone}?text=${message}`
  : null;
---

{href ? (
  <a class="whatsapp" href={href} target="_blank" rel="noopener" aria-label="Book via WhatsApp">◔</a>
) : (
  <button
    class="whatsapp"
    type="button"
    aria-label="Book via WhatsApp (number not configured)"
    title="Set PUBLIC_WHATSAPP_NUMBER in .env to enable this button"
    disabled
  >◔</button>
)}
