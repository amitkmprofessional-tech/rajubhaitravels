---
const customers = [
  "/customers/customer 1.jpg",
  "/customers/customer 2.jpg",
  "/customers/customer 3.jpg",
  "/customers/customer 4.jpg",
  "/customers/customer 5.jpg",
  "/customers/customer 6.jpg",
  "/customers/customer 7.jpg",
  "/customers/customer 8.jpg",
  "/customers/customer 9.jpg",
  "/customers/customer 10.jpg",
  "/customers/customer 11.jpg",
  "/customers/customer 12.jpg",
];
---

<section class="customers shell" id="customers" aria-labelledby="customers-title">

  <div class="customer-gallery">

  <div class="customer-track">

    {[...customers, ...customers].map((photo, index) => (

      <div class="customer-card">

        <img
          src={photo}
          alt={`Happy Customer ${index + 1}`}
          loading="lazy"
        />

      </div>

    ))}

  </div>

</div>

</section>

<style>

.customer-gallery{
    overflow:hidden;
    width:100%;
    margin-top:2rem;
    position:relative;
}

.customer-track{
    display:flex;
    gap:22px;
    width:max-content;
    animation:scroll 35s linear infinite;
}

.customer-gallery:hover .customer-track{
    animation-play-state:paused;
}

.customer-card{
    flex:0 0 auto;
    width:300px;

    border-radius:18px;
    overflow:hidden;

    background:#fff;

    box-shadow:0 10px 25px rgba(0,0,0,.12);

    transition:.35s;
}

.customer-card:hover{
    transform:translateY(-6px);
}

.customer-card img{
    width:100%;
    height:340px;
    object-fit:cover;
    display:block;
}

@keyframes scroll{

    from{
        transform:translateX(0);
    }

    to{
        transform:translateX(calc(-50% - 11px));
    }

}

@media(max-width:768px){

.customer-card{
    width:220px;
}

.customer-card img{
    height:260px;
}

.customer-track{
    animation-duration:22s;
}

}

</style>