---

<section class="tracking shell" id="tracking" aria-labelledby="tracking-title">
  <div class="map-panel" role="img" aria-label="Illustration showing a live trip from pickup to Airport Terminal 3">
    <div class="map-road r1"></div>
    <div class="map-road r2"></div>
    <div class="map-road r3"></div>
    <span class="pin start">●</span>
    <span class="pin end">⌖</span>
    <div class="mini-car">▰</div>
    <div class="map-label start-label">Your pickup</div>
    <div class="map-label end-label">Airport T3</div>
  </div>
  <div class="track-copy">
    <p class="eyebrow">RIDE WITH CONFIDENCE</p>
    <h2 id="tracking-title">Always know<br />where you are.</h2>
    <p>Track your ride in real time, share your trip with loved ones, and arrive with complete peace of mind.</p>
    <ul>
      <li><span aria-hidden="true">✓</span> Live ride tracking</li>
      <li><span aria-hidden="true">✓</span> Verified, trained drivers</li>
      <li><span aria-hidden="true">✓</span> 24/7 trip support</li>
    </ul>
    <a class="dark-btn" href="#booking-form">Book a trackable ride <span aria-hidden="true">→</span></a>
  </div>
</section>
